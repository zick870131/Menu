    function saveDishFromEditor() {
      const id = document.getElementById("edit-dish-id").value;
      const name = document.getElementById("edit-dish-name").value.trim();
      const category = document.getElementById("edit-dish-category").value.trim() || "精選餐點";
      const price = Number(document.getElementById("edit-dish-price").value);
      const emoji = document.getElementById("edit-dish-emoji").value.trim() || "🍽️";
      const tag = document.getElementById("edit-dish-tag").value.trim();
      const description = document.getElementById("edit-dish-desc").value.trim();

      if (!name || isNaN(price) || price < 0) {
        showToast("⚠️ 請填寫正確的餐點名稱與價格");
        return;
      }

      const cleanedGroups = editorDraftGroups
        .map(g => ({
          ...g,
          name: g.name.trim() || "口味選擇",
          options: g.options.filter(o => o.name.trim() !== "")
        }))
        .filter(g => g.options.length > 0);

      const newDishObj = {
        id: id || "dish-" + Date.now(),
        name,
        category,
        price,
        emoji,
        tag,
        description,
        modifierGroups: cleanedGroups
      };

      if (id) {
        const idx = menuData.dishes.findIndex(d => d.id === id);
        if (idx > -1) menuData.dishes[idx] = newDishObj;
      } else {
        menuData.dishes.unshift(newDishObj);
      }

      saveMenuData();
      renderCategoryTabs();
      renderMenuList();
      closeDishEditor();
      showToast("✅ 餐點與口味設定已儲存！");
    }

