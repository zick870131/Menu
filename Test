<body class="bg-stone-300 text-brand-charcoal antialiased selection:bg-orange-200">

  <!-- 手機版置中主容器 (最大寬度 440px，適配所有手機與桌面瀏覽器) -->
  <div id="app-shell" class="mx-auto max-w-[440px] min-h-screen bg-brand-canvas shadow-2xl relative flex flex-col overflow-x-hidden">

    <!-- 1. 頂部固定店家與桌號導覽列 -->
    <header class="sticky top-0 z-30 bg-brand-charcoal text-white px-4 py-3.5 shadow-md">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span id="ui-table-badge" class="shrink-0 bg-brand-orange text-white text-xs font-black px-2.5 py-0.5 rounded-lg tracking-wide shadow-sm">A3 桌</span>
            <h1 id="ui-store-name" class="text-base font-black truncate tracking-tight">試做</h1>
          </div>
          <p class="text-[11px] text-stone-400 mt-0.5 truncate">
            現點現做・自由搭配醬汁、辣度、配料與主菜
          </p>
        </div>

        <!-- 編輯菜單模式切換鈕 (若網址帶 ?mode=guest 會自動隱藏) -->
        <button id="btn-toggle-admin" onclick="toggleAdminMode()" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold transition-all border hover:bg-stone-700 active:scale-95 bg-stone-800 text-orange-300 border-stone-600">
          <span>⚙️</span>
          <span id="admin-btn-text">編輯菜單</span>
        </button>
      </div>

      <!-- 編輯模式專屬操作列 (預設隱藏) -->
      <div id="admin-banner" class="mt-3 pt-2.5 border-t border-stone-700 flex items-center justify-between gap-1.5 text-xs hidden">
        <span class="text-orange-300 font-bold flex items-center gap-1.5 truncate">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse shrink-0"></span>
          <span class="truncate">編輯中（已自動暫存）</span>
        </span>
        <div class="flex items-center gap-1.5 shrink-0">
          <button onclick="downloadStandaloneHtml()" class="px-2.5 py-1.5 rounded-lg bg-emerald-500 text-stone-950 font-black hover:bg-emerald-400 active:scale-95 transition shadow-sm">
            📥 下載 index.html
          </button>
          <button onclick="openExportModal()" class="px-2 py-1.5 rounded-lg bg-stone-700 text-stone-200 font-bold hover:bg-stone-600 transition">
            JSON
          </button>
          <button onclick="openResetConfirm()" class="px-2 py-1.5 rounded-lg bg-stone-700 text-rose-300 font-bold hover:bg-stone-600 transition">
            重置
          </button>
        </div>
      </div>
    </header>

    <!-- 2. 老闆編輯模式：店家設定、桌號網址提示與新增餐點列 (預設隱藏) -->
    <section id="admin-store-panel" class="bg-orange-50 border-b border-orange-200 p-4 space-y-3.5 hidden">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-black uppercase tracking-wider text-orange-900">店家與桌號參數設定</h2>
        <span class="text-[11px] text-orange-700 font-medium">支援 ?table=A1 網址帶入桌號</span>
      </div>

      <div class="grid grid-cols-3 gap-2">
        <div class="col-span-2">
          <label class="block text-[11px] font-bold text-stone-600 mb-1">店家名稱</label>
          <input id="input-store-name" type="text" oninput="updateStoreInfo()" class="w-full px-3 py-2 text-sm bg-white border border-orange-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-orange">
        </div>
        <div>
          <label class="block text-[11px] font-bold text-stone-600 mb-1">預設桌號</label>
          <input id="input-table-number" type="text" oninput="updateStoreInfo()" class="w-full px-3 py-2 text-sm bg-white border border-orange-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-orange">
        </div>
      </div>

      <!-- 快捷忌口標籤編輯 -->
      <div>
        <label class="block text-[11px] font-bold text-stone-600 mb-1">快捷忌口標籤（用逗號或頓號分隔）</label>
        <input id="input-quick-notes" type="text" onchange="updateQuickNotesFromAdmin()" class="w-full px-3 py-2 text-xs bg-white border border-orange-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-orange">
      </div>

      <button onclick="openDishEditor(null)" class="w-full py-2.5 bg-brand-orange hover:bg-brand-orangeHover text-white text-sm font-black rounded-xl shadow-sm active:scale-[0.99] transition flex items-center justify-center gap-1.5">
        <span>＋ 新增餐點與口味群組</span>
      </button>
    </section>

    <!-- 3. 橫向滑動分類導覽列 -->
    <nav class="sticky top-[60px] z-20 bg-brand-canvas/95 backdrop-blur-sm border-b border-stone-200 px-3 py-2.5">
      <div id="category-tabs" class="flex items-center gap-2 overflow-x-auto no-scrollbar">
          <button onclick="selectCategory('全部')" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-brand-orange text-white shadow-sm">
            全部
          </button>
        
          <button onclick="selectCategory('卷餅')" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-white text-stone-600 border border-stone-200 hover:bg-stone-100">
            卷餅
          </button>
        </div>
    </nav>

    <!-- 4. 主菜單卡片列表 -->
    <main id="menu-list-container" class="flex-1 p-4 pb-28 space-y-3.5">
          <div onclick="openDishEditor('dish-1')" class="bg-white rounded-2xl p-4 shadow-sm border border-brand-orange ring-1 ring-orange-200 hover:shadow-md transition cursor-pointer active:scale-[0.99] flex gap-3.5 items-start">

            <!-- 左側圖示框 -->
            <div class="w-16 h-16 rounded-2xl bg-brand-orangeLight border border-orange-100 flex items-center justify-center text-3xl shrink-0">
              🌮
            </div>

            <!-- 中間文字資訊 -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                
                <span class="text-[11px] text-stone-400">卷餅</span>
              </div>

              <h3 class="text-base font-black text-stone-900 mt-0.5 leading-snug">卷餅</h3>
              

              
                <div class="mt-2 inline-flex items-center gap-1 text-[11px] text-orange-800 bg-brand-orangeLight px-2 py-0.5 rounded-md max-w-full truncate font-medium">
                  <span>🎛️ 自選：醬汁風味選擇・加辣・配料區・主菜</span>
                </div>
              

              <div class="mt-3 flex items-center justify-between gap-2">
                <span class="text-sm font-black text-stone-900">NT$ 0（依配料計價）</span>

                
                  <span class="px-3 py-1 rounded-full bg-brand-orange text-white text-xs font-bold shrink-0">
                    ✎ 編輯此餐點
                  </span>
                
              </div>
            </div>
          </div>
