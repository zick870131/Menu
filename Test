    // 一鍵將當前最新菜單資料寫入 HTML 原始碼並觸發瀏覽器下載 index.html
    function downloadStandaloneHtml() {
      try {
        const docClone = document.documentElement.cloneNode(true);

        // 確保下載後的 index.html 開啟時為乾淨的顧客點餐狀態
        const adminBanner = docClone.querySelector("#admin-banner");
        const adminPanel = docClone.querySelector("#admin-store-panel");
        const btnToggle = docClone.querySelector("#btn-toggle-admin");
        const btnText = docClone.querySelector("#admin-btn-text");
        if (adminBanner) adminBanner.classList.add("hidden");
        if (adminPanel) adminPanel.classList.add("hidden");
        if (btnText) btnText.textContent = "編輯菜單";
        if (btnToggle) {
          btnToggle.classList.remove("hidden", "bg-brand-orange", "text-white", "border-orange-400");
          btnToggle.classList.add("bg-stone-800", "text-orange-300", "border-stone-600");
        }

        // 關閉所有可能開啟中的彈窗
        [
          "customizer-modal",
          "cart-drawer-modal",
          "order-success-modal",
          "dish-editor-modal",
          "export-modal",
          "reset-confirm-modal",
          "toast-notification",
          "floating-cart-bar"
        ].forEach(modalId => {
          const el = docClone.querySelector("#" + modalId);
          if (el) el.classList.add("hidden");
        });

        // 將最新 menuData 覆寫進 <script id="menu-data-script">
        const dataScript = docClone.querySelector("#menu-data-script");
        if (dataScript) {
          dataScript.textContent = `\n    const DEFAULT_MENU_DATA = ${JSON.stringify(menuData, null, 2)};\n  `;
        }

        const fullHtml = "<!DOCTYPE html>\n" + docClone.outerHTML;
        const blob = new Blob([fullHtml], { type: "text/html;charset=utf-8" });
        const url = URL.createObjectURL(blob);

        const a = document.createElement("a");
        a.href = url;
        a.download = "index.html";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        showToast("📥 已開始下載 index.html（可直接上傳 Netlify Drop）");
      } catch (e) {
        console.error(e);
        showToast("⚠️ 下載失敗，請改用複製 JSON 備份");
      }
    }

