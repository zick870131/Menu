  <script>
    // =========================================================================
    // 應用程式狀態管理 (State) & 網址參數解析
    // =========================================================================
    const STORAGE_KEY = "shizuo_burrito_menu_v1";
    let menuData = loadMenuData();
    let activeCategory = "全部";
    let isAdminMode = false;
    let isGuestLocked = false; // 當 ?mode=guest 時鎖定為純顧客模式
    let activeTableLabel = menuData.tableNumber; // 實際顯示桌號（優先讀取 ?table= 參數）
    let cart = [];
    let lastSubmittedOrderText = ""; // 儲存最近一筆送出訂單的純文字格式，供一鍵複製貼上 LINE

    // 顧客口味彈窗暫存狀態
    let currentModalDish = null;
    let currentSelections = {};
    let currentQuickNotes = new Set();
    let currentModalQty = 1;

    // 編輯器暫存狀態
    let editorDraftGroups = [];

    // 載入 localStorage 或預設資料
    function loadMenuData() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          return JSON.parse(saved);
        }
      } catch (e) {
        console.error("讀取本地儲存失敗，使用預設菜單", e);
      }
      return JSON.parse(JSON.stringify(DEFAULT_MENU_DATA));
    }

    function saveMenuData() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(menuData));
      } catch (e) {
        showToast("⚠️ 無法儲存至瀏覽器，但目前畫面仍可操作");
      }
    }

    // 解析網址參數：?table=A1 與 ?mode=guest
    function applyUrlParameters() {
      try {
        const params = new URLSearchParams(window.location.search);
        const tableParam = params.get("table");
        const modeParam = params.get("mode");

        if (tableParam && tableParam.trim() !== "") {
          const cleanTable = tableParam.trim();
          // 若參數未包含「桌」字（例如 ?table=A1），自動補上「 桌」；若已包含（例如 ?table=外帶）則原樣顯示
          activeTableLabel = /桌$/.test(cleanTable) ? cleanTable : `${cleanTable} 桌`;
        } else {
          activeTableLabel = menuData.tableNumber;
        }

        if (modeParam && modeParam.toLowerCase() === "guest") {
          isGuestLocked = true;
          const toggleBtn = document.getElementById("btn-toggle-admin");
          if (toggleBtn) toggleBtn.classList.add("hidden");
        }
      } catch (e) {
        activeTableLabel = menuData.tableNumber;
      }
    }

    // 輕量級提示訊息
    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById("toast-notification");
      el.textContent = msg;
      el.classList.remove("hidden");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        el.classList.add("hidden");
      }, 2400);
    }

    // =========================================================================
    // 初始化與畫面渲染
    // =========================================================================
    function initApp() {
      applyUrlParameters();
      renderHeaderInfo();
      renderCategoryTabs();
      renderMenuList();
      updateCartFloatingBar();
    }

    function renderHeaderInfo() {
      document.getElementById("ui-store-name").textContent = menuData.storeName;
      document.getElementById("ui-table-badge").textContent = activeTableLabel;
      document.getElementById("input-store-name").value = menuData.storeName;
      document.getElementById("input-table-number").value = menuData.tableNumber;
      document.getElementById("input-quick-notes").value = (menuData.quickNotes || []).join("、");
      document.title = `${menuData.storeName} (${activeTableLabel}) - 手機掃碼點餐`;
    }

    function renderCategoryTabs() {
      const container = document.getElementById("category-tabs");
      const categories = ["全部", ...new Set(menuData.dishes.map(d => d.category).filter(Boolean))];
      if (!categories.includes(activeCategory)) activeCategory = "全部";

      container.innerHTML = categories.map(cat => {
        const isActive = cat === activeCategory;
        return `
          <button onclick="selectCategory('${escapeHtml(cat)}')"
            class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold transition-all ${
              isActive
                ? "bg-brand-orange text-white shadow-sm"
                : "bg-white text-stone-600 border border-stone-200 hover:bg-stone-100"
            }">
            ${escapeHtml(cat)}
          </button>
        `;
      }).join("");
    }

    function selectCategory(cat) {
      activeCategory = cat;
      renderCategoryTabs();
      renderMenuList();
    }

    function renderMenuList() {
      const container = document.getElementById("menu-list-container");
      const filteredDishes = activeCategory === "全部"
        ? menuData.dishes
        : menuData.dishes.filter(d => d.category === activeCategory);

      if (filteredDishes.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-stone-300">
            <p class="text-stone-400 text-sm">此分類目前沒有餐點</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filteredDishes.map(dish => {
        const groupSummary = (dish.modifierGroups || [])
          .map(g => g.name)
          .join("・");

        const priceLabel = Number(dish.price) > 0 ? `NT$ ${dish.price}` : "NT$ 0（依配料計價）";

        return `
          <div onclick="${isAdminMode ? `openDishEditor('${dish.id}')` : `openCustomizerModal('${dish.id}')`}"
            class="bg-white rounded-2xl p-4 shadow-sm border ${isAdminMode ? 'border-brand-orange ring-1 ring-orange-200' : 'border-stone-200/90'} hover:shadow-md transition cursor-pointer active:scale-[0.99] flex gap-3.5 items-start">

            <!-- 左側圖示框 -->
            <div class="w-16 h-16 rounded-2xl bg-brand-orangeLight border border-orange-100 flex items-center justify-center text-3xl shrink-0">
              ${escapeHtml(dish.emoji || "🍽️")}
            </div>

            <!-- 中間文字資訊 -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                ${dish.tag ? `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-orange-100 text-orange-800">${escapeHtml(dish.tag)}</span>` : ""}
                <span class="text-[11px] text-stone-400">${escapeHtml(dish.category)}</span>
              </div>

              <h3 class="text-base font-black text-stone-900 mt-0.5 leading-snug">${escapeHtml(dish.name)}</h3>
              ${dish.description ? `<p class="text-xs text-stone-500 mt-0.5 line-clamp-2 leading-relaxed">${escapeHtml(dish.description)}</p>` : ""}

              ${groupSummary ? `
                <div class="mt-2 inline-flex items-center gap-1 text-[11px] text-orange-800 bg-brand-orangeLight px-2 py-0.5 rounded-md max-w-full truncate font-medium">
                  <span>🎛️ 自選：${escapeHtml(groupSummary)}</span>
                </div>
              ` : ""}

              <div class="mt-3 flex items-center justify-between gap-2">
                <span class="text-sm font-black text-stone-900">${priceLabel}</span>

                ${isAdminMode ? `
                  <span class="px-3 py-1 rounded-full bg-brand-orange text-white text-xs font-bold shrink-0">
                    ✎ 編輯此餐點
                  </span>
                ` : `
                  <span class="px-3.5 py-1.5 rounded-full bg-brand-charcoal text-white text-xs font-bold flex items-center gap-1 shrink-0">
                    <span>選口味</span>
                    <span class="text-orange-400">＋</span>
                  </span>
                `}
              </div>
            </div>
          </div>
        `;
      }).join("");
    }

    // =========================================================================
    // 顧客口味客製化彈窗邏輯 (Customizer Bottom Sheet)
    // =========================================================================
    function openCustomizerModal(dishId) {
      const dish = menuData.dishes.find(d => d.id === dishId);
      if (!dish) return;

      currentModalDish = dish;
      currentSelections = {};
      currentQuickNotes = new Set();
      currentModalQty = 1;
      document.getElementById("modal-custom-note").value = "";

      (dish.modifierGroups || []).forEach(group => {
        currentSelections[group.id] = [];
      });

      document.getElementById("modal-dish-emoji").textContent = dish.emoji || "🍽️";
      document.getElementById("modal-dish-name").textContent = dish.name;
      document.getElementById("modal-dish-desc").textContent = dish.description || "請依喜好選擇醬汁、辣度、配料與主菜";
      document.getElementById("modal-dish-category").textContent = dish.category;

      const tagEl = document.getElementById("modal-dish-tag");
      if (dish.tag) {
        tagEl.textContent = dish.tag;
        tagEl.classList.remove("hidden");
      } else {
        tagEl.classList.add("hidden");
      }

      renderModalModifierGroups();
      renderQuickNotes();
      updateModalPricing();

      document.getElementById("customizer-modal").classList.remove("hidden");
    }

    function closeCustomizerModal() {
      document.getElementById("customizer-modal").classList.add("hidden");
      currentModalDish = null;
    }

    function renderModalModifierGroups() {
      const body = document.getElementById("modal-options-body");
      const existingGroups = body.querySelectorAll(".dynamic-modifier-group");
      existingGroups.forEach(el => el.remove());

      const groups = currentModalDish.modifierGroups || [];
      const fragment = document.createDocumentFragment();

      groups.forEach(group => {
        const isSingle = group.type === "single";
        const selectedList = currentSelections[group.id] || [];

        const section = document.createElement("div");
        section.className = "dynamic-modifier-group space-y-2.5";

        section.innerHTML = `
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-sm font-black text-stone-900">${escapeHtml(group.name)}</span>
              ${isSingle
                ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-800">單選（再點可取消）</span>`
                : `<span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-stone-100 text-stone-600">可複選 (${selectedList.length} 已選)</span>`
              }
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            ${group.options.map(opt => {
              const isSelected = selectedList.some(s => s.id === opt.id);
              return `
                <button type="button" onclick="toggleModifierOption('${group.id}', '${opt.id}')"
                  class="p-3 rounded-2xl border text-left transition flex items-center justify-between gap-2 active:scale-[0.98] ${
                    isSelected
                      ? "border-brand-orange bg-brand-orangeLight text-stone-950 font-bold ring-1 ring-brand-orange"
                      : "border-stone-200 bg-white text-stone-700 hover:bg-stone-50"
                  }">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="w-4 h-4 shrink-0 flex items-center justify-center rounded-${isSingle ? 'full' : 'md'} border text-[10px] ${
                      isSelected ? 'bg-brand-orange border-brand-orange text-white font-black' : 'border-stone-300'
                    }">
                      ${isSelected ? '✓' : ''}
                    </span>
                    <span class="text-xs leading-snug break-words">${escapeHtml(opt.name)}</span>
                  </div>
                  <span class="text-[11px] shrink-0 ${opt.price > 0 ? 'text-brand-orange font-black' : 'text-stone-400'}">
                    ${opt.price > 0 ? `+NT$${opt.price}` : "免費"}
                  </span>
                </button>
              `;
            }).join("")}
          </div>
        `;
        fragment.appendChild(section);
      });

      body.insertBefore(fragment, body.firstChild);
    }

    function toggleModifierOption(groupId, optionId) {
      const group = currentModalDish.modifierGroups.find(g => g.id === groupId);
      if (!group) return;
      const option = group.options.find(o => o.id === optionId);
      if (!option) return;

      const list = currentSelections[groupId] || [];
      const existingIdx = list.findIndex(o => o.id === optionId);

      if (group.type === "single") {
        // 單選模式：支援再次點擊已選項目取消選取
        if (existingIdx > -1) {
          currentSelections[groupId] = [];
        } else {
          currentSelections[groupId] = [option];
        }
      } else {
        // 複選模式
        if (existingIdx > -1) {
          list.splice(existingIdx, 1);
        } else {
          list.push(option);
        }
        currentSelections[groupId] = list;
      }

      renderModalModifierGroups();
      updateModalPricing();
    }

    function renderQuickNotes() {
      const container = document.getElementById("quick-notes-container");
      container.innerHTML = (menuData.quickNotes || []).map(note => {
        const active = currentQuickNotes.has(note);
        return `
          <button type="button" onclick="toggleQuickNote('${escapeHtml(note)}')"
            class="px-3.5 py-1.5 rounded-full text-xs font-bold border transition active:scale-95 ${
              active
                ? "bg-brand-charcoal text-orange-300 border-brand-charcoal"
                : "bg-stone-50 text-stone-600 border-stone-200 hover:bg-stone-100"
            }">
            ${active ? "✓ " : "+ "}${escapeHtml(note)}
          </button>
        `;
      }).join("");
    }

    function toggleQuickNote(note) {
      if (currentQuickNotes.has(note)) {
        currentQuickNotes.delete(note);
      } else {
        currentQuickNotes.add(note);
      }
      renderQuickNotes();
    }

    function changeModalQty(delta) {
      currentModalQty = Math.max(1, currentModalQty + delta);
      updateModalPricing();
    }

    function updateModalPricing() {
      if (!currentModalDish) return;

      document.getElementById("modal-qty-value").textContent = currentModalQty;

      let extraPerItem = 0;
      Object.values(currentSelections).forEach(optList => {
        optList.forEach(opt => {
          extraPerItem += Number(opt.price || 0);
        });
      });

      const unitPrice = Number(currentModalDish.price) + extraPerItem;
      const totalPrice = unitPrice * currentModalQty;

      document.getElementById("btn-add-cart-price").textContent = `NT$ ${totalPrice}`;
    }

    function confirmAddToCart() {
      if (!currentModalDish) return;

      const groupedDetails = [];
      const flatSummaryParts = [];
      let extraPrice = 0;

      (currentModalDish.modifierGroups || []).forEach(group => {
        const opts = currentSelections[group.id] || [];
        if (opts.length > 0) {
          const names = opts.map(o => o.price > 0 ? `${o.name}(+$${o.price})` : o.name);
          groupedDetails.push({
            groupName: group.name,
            items: names
          });
          flatSummaryParts.push(`【${group.name}】${names.join("、")}`);
          opts.forEach(o => {
            extraPrice += Number(o.price || 0);
          });
        }
      });

      const notesList = [];
      currentQuickNotes.forEach(n => notesList.push(n));
      const freeTextNote = document.getElementById("modal-custom-note").value.trim();
      if (freeTextNote) {
        notesList.push(freeTextNote);
      }
      if (notesList.length > 0) {
        groupedDetails.push({
          groupName: "忌口備註",
          items: notesList
        });
        flatSummaryParts.push(`【忌口備註】${notesList.join("、")}`);
      }

      const unitPrice = Number(currentModalDish.price) + extraPrice;
      const summaryKey = `${currentModalDish.id}__${flatSummaryParts.join("|")}`;

      const existingItem = cart.find(item => item.summaryKey === summaryKey);
      if (existingItem) {
        existingItem.qty += currentModalQty;
      } else {
        cart.push({
          cartId: "c-" + Date.now() + Math.random().toString(36).slice(2, 6),
          summaryKey,
          dishId: currentModalDish.id,
          name: currentModalDish.name,
          emoji: currentModalDish.emoji,
          unitPrice,
          qty: currentModalQty,
          groupedDetails
        });
      }

      closeCustomizerModal();
      updateCartFloatingBar();
      showToast(`已加入「${currentModalDish.name}」`);
    }

